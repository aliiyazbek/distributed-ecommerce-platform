{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ecommerce_db;Username=ecommerce_user;Password=ecommerce_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false,connectTimeout=500,syncTimeout=500"
  },
  "Caching": {
    "Enabled": true,
    "ProductTtlSeconds": 300,
    "ProductListTtlSeconds": 60,
    "FailureCooldownSeconds": 30
  },
  "AllowedHosts": "*"
}